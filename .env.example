# Server-only Laravel base URL. This backend currently has no /api prefix.
LARAVEL_API_URL=http://127.0.0.1:8000

# Exact browser-facing origin, without a path. Match the port used by npm run dev.
# When using an HTTPS tunnel, set this to that tunnel's public HTTPS origin.
# On Laravel Cloud use the deployed Careers HTTPS origin; see docs/laravel-cloud.md.
APP_ORIGIN=http://localhost:3001

# Total backend request deadline, including the response body (100..120000 ms).
LARAVEL_API_TIMEOUT_MS=30000
